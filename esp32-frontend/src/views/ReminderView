<script setup lang="ts">
import { ref, computed, onMounted, reactive } from 'vue'
import { useReminderStore } from '@/stores/reminder'
import type { Reminder, ReminderDTO } from '@/types'

// 状态
const reminderStore = useReminderStore()
const loading = ref(false)
const error = ref<string | null>(null)
const submitting = ref(false)
const currentPage = ref(1)
const itemsPerPage = 10
const editingReminder = ref<Reminder | null>(null)
const deletingReminder = ref<Reminder | null>(null)

// 表单数据
const formData = reactive<ReminderDTO>({
  deviceId: 'esp32-01',
  content: '',
  reminderTime: '08:00',
  repeat: 'daily',
  priority: 'normal',
  note: '',
  enabled: true
})

// 筛选条件
const filter = reactive({
  status: '',
  priority: ''
})

// 计算属性
const filteredReminders = computed(() => {
  let reminders = [...reminderStore.reminders]

  if (filter.status) {
    reminders = reminders.filter(r => r.status === filter.status)
  }
  if (filter.priority) {
    reminders = reminders.filter(r => r.priority === filter.priority)
  }

  return reminders.sort((a, b) =>
    new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()
  )
})

const paginatedReminders = computed(() => {
  const start = (currentPage.value - 1) * itemsPerPage
  const end = start + itemsPerPage
  return filteredReminders.value.slice(start, end)
})

const totalPages = computed(() =>
  Math.ceil(filteredReminders.value.length / itemsPerPage)
)

// 方法
const refreshReminders = async () => {
  loading.value = true
  error.value = null
  try {
    await reminderStore.fetchReminders('esp32-01')
  } catch (err: any) {
    error.value = err.message || '加载失败'
  } finally {
    loading.value = false
  }
}

const handleSubmit = async () => {
  if (submitting.value) return

  submitting.value = true
  try {
    await reminderStore.createReminder({ ...formData })
    resetForm()
  } catch (err: any) {
    error.value = err.message || '创建失败'
  } finally {
    submitting.value = false
  }
}

const resetForm = () => {
  formData.content = ''
  formData.reminderTime = '08:00'
  formData.note = ''
  formData.priority = 'normal'
}

const triggerReminder = async (id: number) => {
  try {
    await reminderStore.triggerReminder(id)
  } catch (err: any) {
    error.value = err.message || '触发失败'
  }
}

const editReminder = (reminder: Reminder) => {
  editingReminder.value = { ...reminder }
}

const confirmDelete = (reminder: Reminder) => {
  deletingReminder.value = reminder
}

const cancelDelete = () => {
  deletingReminder.value = null
}

const deleteReminder = async () => {
  if (!deletingReminder.value) return

  try {
    await reminderStore.deleteReminder(deletingReminder.value.id)
    deletingReminder.value = null
  } catch (err: any) {
    error.value = err.message || '删除失败'
  }
}

const closeModal = () => {
  editingReminder.value = null
}

const formatTime = (time: string) => {
  return time.split('T')[1]?.substring(0, 5) || time.substring(0, 5)
}

const formatDate = (date: string) => {
  return new Date(date).toLocaleDateString('zh-CN')
}

const formatRepeat = (repeat: string) => {
  const map: Record<string, string> = {
    once: '仅一次',
    daily: '每天',
    weekly: '每周',
    monthly: '每月'
  }
  return map[repeat] || repeat
}

const formatPriority = (priority: string) => {
  const map: Record<string, string> = {
    high: '高',
    normal: '普通',
    low: '低'
  }
  return map[priority] || priority
}

const formatStatus = (status: string) => {
  const map: Record<string, string> = {
    pending: '待触发',
    triggered: '已触发',
    acknowledged: '已确认'
  }
  return map[status] || status
}

const prevPage = () => {
  if (currentPage.value > 1) {
    currentPage.value--
  }
}

const nextPage = () => {
  if (currentPage.value < totalPages.value) {
    currentPage.value++
  }
}

// 生命周期
onMounted(() => {
  refreshReminders()
})
</script>

